# LLM 副驾驶 — 真实 API keys
# 复制此文件为 .env 并填入真实 keys；.env 已在 .gitignore 中
# 也可以直接 export env vars 而不用 .env 文件

# === LLM（主）===
# 必填之一：anthropic / openai 兼容
# 无 key 时 LLM 副驾驶自动跳过（不影响主报告）
LLM_API_KEY=
LLM_BACKEND=openai
# MiniMax M3 走 openai 兼容协议：
#   LLM_BASE_URL=https://api.MiniMax.chat   (注意：不要加 /v1)
#   LLM_MODEL=MiniMax-M3
# Anthropic 走官方：
#   LLM_BASE_URL=                              (留空 = 默认)
#   LLM_MODEL=claude-3-5-haiku-latest
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
LLM_USAGE_LOG=references/llm_usage.jsonl

# === 新闻搜索（v2 工具）===
# Tavily（主）：https://tavily.com — 免费档 1000 次/月
# 注册后在 https://app.tavily.com/ 拿到 key
TAVILY_API_KEY=

# SerpAPI（fallback）：https://serpapi.com — 免费档 100 次/月
# 注册后在 dashboard 拿到 key
SERPAPI_KEY=

# 两个都缺时自动走 mock（7 条硬编码假新闻）
NEWS_TIMEOUT_S=5
NEWS_MAX_RESULTS=5
