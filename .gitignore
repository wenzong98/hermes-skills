# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# --- Build / install ---
dist/
build/
*.egg

# --- OS / editors ---
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# --- Project scratch / artifacts ---
work/
outputs/
references/data_cache/
scripts/references/data_cache/
!references/cape_vintage.csv

# Local persistent runtime databases. These include market caches, archived
# decisions, and potentially sensitive real execution/account records.
data/*.db

# Persistent per-skill run state (not source-controlled)
references/cron_run/.trim_state.json

# --- Dashboard build artifacts (regenerated by scripts/build_dashboard.py) ---
# The HTML template lives in scripts/_dashboard_template.html and IS tracked.
# These three files are written by the builder and contain the full data.json
# payload plus an inlined asset. They are large, change on every run, and
# only ever re-built from the template + data inputs.
references/dashboard/data.json
references/dashboard/index.html
references/dashboard/dashboard.html

# Vendor script is downloaded by _ensure_vendor(); ~1 MB. Re-downloaded on
# first build if missing.
references/dashboard/vendor/

# --- Secrets / API keys ---
# .env 包含真实 API key，**绝不可** commit
# 复制 .env.example 为 .env 填入真实 key
.env
.env.local
.env.*.local

# --- ECC integration experiment (per-project local state) ---
# Knowledge graph: regenerated from scripts/build_mini_graph.py
.understand-anything-lite/
# Homunculus: continuous-learning-c2 observation + session metrics
.claude/homunculus/
